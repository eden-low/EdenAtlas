rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasVerifiedEmail() {
      return request.auth != null
             && request.auth.token.email is string
             && request.auth.token.email.size() > 0
             && request.auth.token.email.size() <= 254
             && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return hasVerifiedEmail() && request.auth.token.email.lower() == 'jjun8647@gmail.com';
    }
    function isFriend() {
      return hasVerifiedEmail()
             && exists(/databases/$(database)/documents/friends/$(request.auth.token.email.lower()));
    }
    // Display classification only. The client never chooses its own role: rules derive it from
    // the verified Firebase identity and the server-owned friends whitelist.
    function expectedRole() {
      return isOwner() ? 'owner' : (isFriend() ? 'friend' : 'viewer');
    }
    // Who may create their own private content (own expenses/journal/photos/etc.) —
    // the owner, or anyone the owner has approved into the friends whitelist.
    function canParticipate() {
      return isOwner() || isFriend();
    }
    // v3.2: mutual-consent friend graph (friend_requests/friendships below) — distinct from the
    // legacy isFriend() whitelist role-check above (kept a different name to avoid shadowing it).
    // True once `ownerUid` has accepted the caller into friendships/{ownerUid}/friends/{caller}.
    function isAcceptedFriend(ownerUid) {
      return hasVerifiedEmail()
             && exists(/databases/$(database)/documents/friendships/$(ownerUid)/friends/$(request.auth.uid));
    }
    function isMineOrPublic(data) {
      return request.auth != null && (
        data.uid == request.auth.uid
        || data.visibility == 'public'
        || (data.visibility == 'connections' && isAcceptedFriend(data.uid))
      );
    }
    // Same as isMineOrPublic, plus uploadedBy compatibility only when canonical uid is absent.
    // A conflicting uploadedBy value never grants a second user access.
    function isPhotoMineOrPublic(data) {
      return request.auth != null
             && (data.uid == request.auth.uid
                 || (!('uid' in data) && data.uploadedBy == request.auth.uid)
                 || data.visibility == 'public'
                 || (data.visibility == 'connections' && isAcceptedFriend(data.uid)));
    }
    function canReadPost(photoId) {
      let post = get(/databases/$(database)/documents/photos/$(photoId)).data;
      return isPhotoMineOrPublic(post);
    }

    // Canonical Expense validation. Creates are strict and exact; updates validate the resulting
    // canonical fields but use diff().affectedKeys() so an unchanged, unknown field on a genuine
    // legacy document does not make that document permanently uneditable.
    function validExpenseAmount(data) {
      return data.amount is number && data.amount > 0 && data.amount <= 100000000;
    }
    function validExpenseCategory(data) {
      return data.category in ['food', 'transport', 'shopping', 'bills', 'other'];
    }
    function validExpenseText(data) {
      return data.note is string && data.note.size() <= 240
        && (!('locationName' in data) || data.locationName == null
            || (data.locationName is string && data.locationName.size() <= 200));
    }
    function validExpenseCollection(data) {
      return !('collectionId' in data) || data.collectionId == null
        || (data.collectionId is string && data.collectionId.size() > 0
            && data.collectionId.size() <= 128);
    }
    function validExpenseTags(data) {
      return !('tags' in data) || (
        data.tags is list && data.tags.size() <= 10
        && (data.tags.size() <= 0 || (data.tags[0] is string && data.tags[0].size() > 0 && data.tags[0].size() <= 40))
        && (data.tags.size() <= 1 || (data.tags[1] is string && data.tags[1].size() > 0 && data.tags[1].size() <= 40))
        && (data.tags.size() <= 2 || (data.tags[2] is string && data.tags[2].size() > 0 && data.tags[2].size() <= 40))
        && (data.tags.size() <= 3 || (data.tags[3] is string && data.tags[3].size() > 0 && data.tags[3].size() <= 40))
        && (data.tags.size() <= 4 || (data.tags[4] is string && data.tags[4].size() > 0 && data.tags[4].size() <= 40))
        && (data.tags.size() <= 5 || (data.tags[5] is string && data.tags[5].size() > 0 && data.tags[5].size() <= 40))
        && (data.tags.size() <= 6 || (data.tags[6] is string && data.tags[6].size() > 0 && data.tags[6].size() <= 40))
        && (data.tags.size() <= 7 || (data.tags[7] is string && data.tags[7].size() > 0 && data.tags[7].size() <= 40))
        && (data.tags.size() <= 8 || (data.tags[8] is string && data.tags[8].size() > 0 && data.tags[8].size() <= 40))
        && (data.tags.size() <= 9 || (data.tags[9] is string && data.tags[9].size() > 0 && data.tags[9].size() <= 40))
      );
    }
    function validExpenseLocation(data) {
      return (!('latitude' in data) && !('longitude' in data))
        || (data.latitude == null && data.longitude == null)
        || (data.latitude is number && data.longitude is number
            && data.latitude >= -90 && data.latitude <= 90
            && data.longitude >= -180 && data.longitude <= 180);
    }
    function validExpenseCanonicalFields(data) {
      return data.keys().hasAll(['uid', 'amount', 'currency', 'category', 'note', 'date', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && validExpenseAmount(data)
        && data.currency == 'MYR'
        && validExpenseCategory(data)
        && data.date is timestamp
        && data.createdAt is timestamp
        && validExpenseText(data)
        && validExpenseCollection(data)
        && validExpenseTags(data)
        && validExpenseLocation(data);
    }

    // Always-private: financial data has no "public" story.
    match /expenses/{expenseId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // v3.3 "Friend Spaces": Finance is one of three modules (with Time Capsule/Daily
      // Reflection) that stay Owner-only even though Friends now get their own space for
      // Memories/Journal/Journey/Habits — create is isOwner(), not canParticipate(). read/
      // update/delete stay a bare ownership check so any expense docs a Friend created before
      // this pass remain theirs to view/edit — only new Finance writes are cut off going forward.
      allow create: if isOwner()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'amount', 'currency', 'category', 'note', 'date', 'createdAt',
          'collectionId', 'tags', 'locationName', 'latitude', 'longitude'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'amount', 'currency', 'category', 'note', 'date', 'createdAt',
          'collectionId', 'tags', 'locationName', 'latitude', 'longitude'
        ])
        && validExpenseCanonicalFields(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount', 'currency', 'category', 'note', 'date', 'collectionId', 'tags',
          'locationName', 'latitude', 'longitude', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validExpenseCanonicalFields(request.resource.data);
    }

    // Always-private: personal targets have no "public" story, same shape as expenses. Not one of
    // v3.3's three owner-only modules — Goals stays canParticipate() (Owner or Friend).
    match /goals/{goalId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow create: if canParticipate() && request.resource.data.uid == request.auth.uid;
    }

    // Always-private (v2.9): messages sealed for the writer's own future self. Same
    // owner-only shape as goals/expenses — never readable via isMineOrPublic(), by design.
    function validCapsuleCore(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.message is string && data.message.size() > 0 && data.message.size() <= 10000
        && data.openAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.status in ['sealed', 'opened']
        && data.visibility == 'private';
    }
    function validNewCapsuleAttachment(data, capsuleId) {
      return (data.attachmentPath == null && data.attachmentType == null)
        || (data.attachmentPath is string
            && data.attachmentPath == 'capsules/' + data.uid + '/' + capsuleId
            && data.attachmentType in ['image', 'file']);
    }
    function validCapsuleSchema(data, capsuleId) {
      return data.keys().hasOnly([
          'uid', 'title', 'message', 'openAt', 'createdAt', 'updatedAt',
          'status', 'visibility', 'attachmentPath', 'attachmentType'
        ])
        && data.keys().hasAll([
          'uid', 'title', 'message', 'openAt', 'createdAt', 'updatedAt',
          'status', 'visibility', 'attachmentPath', 'attachmentType'
        ])
        && validCapsuleCore(data)
        && validNewCapsuleAttachment(data, capsuleId);
    }
    // Exact legacy shape emitted by the pre-P0 client. It is recognized only as the source of a
    // one-way transition into the canonical schema below; no legacy create is allowed.
    function validLegacyCapsuleSchema(data) {
      return data.keys().hasOnly([
          'uid', 'title', 'message', 'openAt', 'createdAt', 'updatedAt',
          'status', 'visibility', 'attachmentUrl', 'attachmentType'
        ])
        && data.keys().hasAll([
          'uid', 'title', 'message', 'openAt', 'createdAt', 'updatedAt',
          'status', 'visibility', 'attachmentUrl', 'attachmentType'
        ])
        && validCapsuleCore(data)
        && (data.attachmentUrl == null || data.attachmentUrl is string)
        && (data.attachmentType == null || data.attachmentType in ['image', 'file']);
    }
    function validCapsuleStatusTransition(before, after) {
      return (before.status == 'sealed' && after.status == 'sealed')
        || (before.status == 'sealed' && after.status == 'opened'
            && before.openAt <= request.time
            && after.title == before.title
            && after.message == before.message
            && after.openAt == before.openAt)
        || (before.status == 'opened' && after.status == 'opened'
            && after.title == before.title
            && after.message == before.message
            && after.openAt == before.openAt);
    }

    match /time_capsules/{capsuleId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if isOwner()
                    && request.resource.data.uid == request.auth.uid
                    && validCapsuleSchema(request.resource.data, capsuleId)
                    && request.resource.data.status == 'sealed'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.visibility == resource.data.visibility
                    && validCapsuleSchema(request.resource.data, capsuleId)
                    && request.resource.data.updatedAt == request.time
                    && (
                      (resource.data.status == 'sealed'
                        && request.resource.data.status == 'sealed'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'title', 'message', 'openAt', 'updatedAt'
                        ]))
                      || (resource.data.status == 'sealed'
                        && request.resource.data.status == 'opened'
                        && resource.data.openAt <= request.time
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status', 'updatedAt'
                        ]))
                    );
      // Bounded compatibility: an exact legacy document may become canonical once. The URL is
      // removed, a canonical own-document object identity (or explicit null) replaces it, and
      // all identity/private fields remain immutable. It can never transition back to legacy.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && validLegacyCapsuleSchema(resource.data)
                    && validCapsuleSchema(request.resource.data, capsuleId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.visibility == resource.data.visibility
                    && request.resource.data.updatedAt == request.time
                    && validCapsuleStatusTransition(resource.data, request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'title', 'message', 'openAt', 'status', 'updatedAt',
                      'attachmentUrl', 'attachmentPath', 'attachmentType'
                    ]);
    }

    // Always-private (v2.9): one-per-day mood/note checkpoint. Doc ID is `${uid}_${dateKey}`
    // (enforced client-side, see index.html) so a same-day save is a merge, not a duplicate.
    match /daily_reflections/{reflectionId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      // v3.3: Owner-only create — see expenses' match block above for the full reasoning.
      allow create: if isOwner() && request.resource.data.uid == request.auth.uid;
    }

    match /journals/{journalId} {
      allow read: if isMineOrPublic(resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow create: if canParticipate() && request.resource.data.uid == request.auth.uid;
    }

    match /life_events/{eventId} {
      allow read: if isMineOrPublic(resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow create: if canParticipate() && request.resource.data.uid == request.auth.uid;
    }

    match /habits/{habitId} {
      allow read: if isMineOrPublic(resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow create: if canParticipate() && request.resource.data.uid == request.auth.uid;
    }

    // Discover (Owner-only): a personal AniList follow list. Strictly Owner-only end to end —
    // product decision, not a technical default — so this uses isOwner() throughout, never
    // canParticipate(), the same pattern career_* uses for the same reason. Doc ID is
    // deterministic (`${uid}_${anilistId}`, same "structural uniqueness" trick as
    // daily_reflections/usernames) so create-vs-update is Firestore's own idempotent
    // follow/already-followed distinction. No visibility field — this collection has no public/
    // connections story at all, so it never goes through isMineOrPublic().
    match /followed_anime/{id} {
      allow read, delete: if isOwner() && resource.data.uid == request.auth.uid;

      // notifyOnAiring (opt-in per-anime airing push reminder toggle) is REQUIRED on create so
      // every doc has a defined value from day one — the client always writes it explicitly
      // (defaulting to false), never omits it. nextEpisodeSnapshot/scheduleRefreshedAt are
      // deliberately NOT in this client-facing keys().hasOnly() allowlist: they're written only
      // by the scheduled Netlify Function (backend/netlify/functions/anime-airing-check.js) via Firebase
      // Admin, which bypasses these rules entirely (same as every other Admin-only field in this
      // app — see CLAUDE.md's repeated "Firebase Admin bypasses firestore.rules entirely" note).
      // A client updateDoc() is a partial write, so an update that only touches status/
      // notifyOnAiring never clobbers those server-only fields even though this allowlist
      // doesn't mention them.
      allow create: if isOwner()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + string(request.resource.data.anilistId)
        && request.resource.data.keys().hasOnly(
             ['uid', 'anilistId', 'mediaType', 'title', 'coverImage', 'format', 'status', 'isAdult', 'notifyOnAiring', 'followedAt', 'updatedAt']
           )
        && request.resource.data.anilistId is int && request.resource.data.anilistId > 0
        && request.resource.data.mediaType == 'ANIME'
        && request.resource.data.title is string
        && (request.resource.data.coverImage == null || request.resource.data.coverImage is string)
        && (request.resource.data.format == null || request.resource.data.format is string)
        && request.resource.data.status in ['planning', 'watching', 'completed', 'paused', 'dropped']
        && request.resource.data.isAdult == false
        && request.resource.data.notifyOnAiring is bool
        && request.resource.data.followedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // uid/anilistId/mediaType/followedAt are immutable — only title/coverImage/format/status/
      // notifyOnAiring may change from the CLIENT (a display-metadata refresh, a status change,
      // or the per-anime notification toggle), and updatedAt must always be freshly stamped on
      // every client update. This same rule also governs the scheduled Function's writes, but
      // Admin SDK calls bypass rules entirely (see the create-rule comment above) — this
      // constraint is enforced against the browser client only.
      allow update: if isOwner()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.anilistId == resource.data.anilistId
        && request.resource.data.mediaType == resource.data.mediaType
        && request.resource.data.keys().hasOnly(
             ['uid', 'anilistId', 'mediaType', 'title', 'coverImage', 'format', 'status', 'isAdult', 'notifyOnAiring', 'followedAt', 'updatedAt']
           )
        && request.resource.data.title is string
        && (request.resource.data.coverImage == null || request.resource.data.coverImage is string)
        && (request.resource.data.format == null || request.resource.data.format is string)
        && request.resource.data.status in ['planning', 'watching', 'completed', 'paused', 'dropped']
        && request.resource.data.isAdult == false
        && request.resource.data.notifyOnAiring is bool
        && request.resource.data.followedAt == resource.data.followedAt
        && request.resource.data.updatedAt == request.time;
    }

    // Phase 4 — opt-in per-anime airing push reminders. One doc per subscribed browser/device
    // (id = uid + tokenHash, the same deterministic-ID "structural uniqueness" trick as
    // followed_anime/usernames/daily_reflections — see CLAUDE.md), never the raw FCM token as
    // the doc ID (tokens can contain characters Firestore doc IDs don't love, and hashing keeps
    // the ID shape uniform). Strictly Owner-only, same as every other Discover collection — see
    // CLAUDE.md's "Discover is now strictly Owner-only" note.
    match /push_subscriptions/{id} {
      // subscribeThisDevice() (js/push-notifications.js) does a getDoc() existence check before
      // deciding create-vs-update-only, so this rule must tolerate a not-yet-existing doc: for a
      // brand-new device, `resource` is null, and dereferencing `resource.data` on null is a
      // rules EVALUATION ERROR (not a clean `false`) — Firestore reports that to the client as
      // PERMISSION_DENIED, identical to a real denial, on the very first subscribe attempt.
      // `resource == null` short-circuits before the dereference, for both get and delete
      // (delete of an already-gone doc must also stay a harmless no-op, not an error) — isOwner()
      // is unchanged and still the sole gate, so this never grants access to anyone but the Owner,
      // it only lets the Owner's own existence check on their OWN not-yet-existing doc resolve
      // cleanly instead of erroring closed.
      allow read, delete: if isOwner() && (resource == null || resource.data.uid == request.auth.uid);

      allow create: if isOwner()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.tokenHash
        && request.resource.data.keys().hasOnly(['uid', 'tokenHash', 'token', 'platform', 'createdAt', 'updatedAt'])
        && request.resource.data.tokenHash is string && request.resource.data.tokenHash.size() > 0
        && request.resource.data.token is string && request.resource.data.token.size() > 0
        && request.resource.data.platform == 'web'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only a token "last seen" refresh is allowed from the client (uid/tokenHash/token/platform
      // immutable) — a genuinely new token is always a new document (a new deterministic ID), never
      // an update of an existing one.
      allow update: if isOwner()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tokenHash == resource.data.tokenHash
        && request.resource.data.token == resource.data.token
        && request.resource.data.platform == resource.data.platform
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'tokenHash', 'token', 'platform', 'createdAt', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // Delivery-dedup log for the scheduled airing-check Function (Requirement: "Store a
    // deterministic delivery key so the same anime episode is not notified twice"). Written
    // exclusively by that Function via Firebase Admin (bypasses these rules entirely, same as
    // every other server-only collection — see the ai_usage* precedent in CLAUDE.md). No client
    // create/update/delete rule is defined at all, so Firestore's own default-deny already closes
    // client writes with no rule needed; read is opened for the Owner only as a debugging/
    // transparency aid (Me/Discover could surface "last reminder sent" from this in a future
    // pass — not built yet).
    match /anime_notification_log/{id} {
      allow read: if isOwner() && resource.data.uid == request.auth.uid;
    }

    // Collections (v2.7): life-chapter containers that group existing records via
    // collectionId, same shape/visibility model as journals/life_events/habits.
    match /collections/{collectionId} {
      allow read: if isMineOrPublic(resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow create: if canParticipate() && request.resource.data.uid == request.auth.uid;
    }

    // Career CMS: the canonical global policy lives on public_profiles/{uid}. It is intersected
    // with each item's visibility so an item can narrow, but never broaden, global access.
    function hasValidCareerVisibility(uid) {
      return exists(/databases/$(database)/documents/public_profiles/$(uid))
        && get(/databases/$(database)/documents/public_profiles/$(uid)).data.careerVisibility
          in ['private', 'connections', 'public'];
    }
    function careerVisibility(uid) {
      return get(/databases/$(database)/documents/public_profiles/$(uid)).data.careerVisibility;
    }
    function isCareerReadable(data) {
      return (request.auth != null && data.uid == request.auth.uid)
        || (hasValidCareerVisibility(data.uid) && (
          (careerVisibility(data.uid) == 'public' && data.visibility == 'public')
          || (careerVisibility(data.uid) in ['connections', 'public']
              && data.visibility in ['public', 'connections']
              && isAcceptedFriend(data.uid))
        ));
    }
    // Storage authorization consumes this bounded per-item snapshot plus, only for connection
    // reads, the live friendship document. Every client Career write must match the effective
    // profile exactly. Policy fields and the transition lock on public_profiles are server-only;
    // the privileged transition endpoint updates the profile and every item atomically.
    function validCareerPolicySnapshot(data) {
      return data.careerVisibility in ['private', 'connections', 'public']
        && data.careerPolicyVersion is int
        && data.careerPolicyVersion >= 1
        && existsAfter(/databases/$(database)/documents/public_profiles/$(data.uid))
        && !('careerPolicyTransition' in
          getAfter(/databases/$(database)/documents/public_profiles/$(data.uid)).data)
        && getAfter(/databases/$(database)/documents/public_profiles/$(data.uid)).data.careerVisibility
          == data.careerVisibility
        && getAfter(/databases/$(database)/documents/public_profiles/$(data.uid)).data.careerPolicyVersion
          == data.careerPolicyVersion;
    }
    function careerPolicyIsUnlocked(uid) {
      return existsAfter(/databases/$(database)/documents/public_profiles/$(uid))
        && !('careerPolicyTransition' in
          getAfter(/databases/$(database)/documents/public_profiles/$(uid)).data);
    }
    match /career_experiences/{id} {
      allow read: if isCareerReadable(resource.data);
      allow create: if isOwner() && request.resource.data.uid == request.auth.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow update: if isOwner() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow delete: if isOwner() && resource.data.uid == request.auth.uid
                    && careerPolicyIsUnlocked(resource.data.uid);
    }
    match /career_projects/{id} {
      allow read: if isCareerReadable(resource.data);
      allow create: if isOwner() && request.resource.data.uid == request.auth.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow update: if isOwner() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow delete: if isOwner() && resource.data.uid == request.auth.uid
                    && careerPolicyIsUnlocked(resource.data.uid);
    }
    match /career_certificates/{id} {
      allow read: if isCareerReadable(resource.data);
      allow create: if isOwner() && request.resource.data.uid == request.auth.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow update: if isOwner() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow delete: if isOwner() && resource.data.uid == request.auth.uid
                    && careerPolicyIsUnlocked(resource.data.uid);
    }
    match /career_awards/{id} {
      allow read: if isCareerReadable(resource.data);
      allow create: if isOwner() && request.resource.data.uid == request.auth.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow update: if isOwner() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && validCareerPolicySnapshot(request.resource.data);
      allow delete: if isOwner() && resource.data.uid == request.auth.uid
                    && careerPolicyIsUnlocked(resource.data.uid);
    }

    match /photos/{photoId} {
      allow read: if isPhotoMineOrPublic(resource.data);
      // uid is canonical whenever present. uploadedBy is a compatibility owner only for a
      // genuinely legacy document without uid. Neither ownership field may be changed, added,
      // or removed by an update.
      allow update: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || (!('uid' in resource.data) && resource.data.uploadedBy == request.auth.uid))
                    && (
                      (('uid' in resource.data) && request.resource.data.uid == resource.data.uid)
                      || (!('uid' in resource.data) && !('uid' in request.resource.data))
                    )
                    && (
                      (('uploadedBy' in resource.data)
                        && request.resource.data.uploadedBy == resource.data.uploadedBy)
                      || (!('uploadedBy' in resource.data) && !('uploadedBy' in request.resource.data))
                    );
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || (!('uid' in resource.data) && resource.data.uploadedBy == request.auth.uid));
      allow create: if canParticipate()
                    && request.resource.data.uid == request.auth.uid
                    && !('uploadedBy' in request.resource.data);

      match /likes/{uid} {
        allow read: if canReadPost(photoId);
        allow write: if request.auth != null && request.auth.uid == uid && canReadPost(photoId);
      }
      match /comments/{commentId} {
        allow read: if canReadPost(photoId);
        allow create: if request.auth != null
                       && request.auth.uid == request.resource.data.uid
                       && canReadPost(photoId);
        allow update, delete: if false;
      }
      match /views/{viewId} {
        // Only the post's own owner needs to read view analytics for their post.
        allow read: if request.auth != null && get(/databases/$(database)/documents/photos/$(photoId)).data.uid == request.auth.uid;
        allow create: if request.auth != null
                       && request.auth.uid == request.resource.data.viewerUid
                       && canReadPost(photoId);
        allow update, delete: if false;
      }
    }

    // v3.2 Trusted Connections: mutual-consent friend-request graph, entirely separate from the
    // legacy owner/friend/viewer role whitelist (`friends/{email}` below). Every write here is
    // scoped to the caller's own uid path segment — no transactions, no cross-uid writes ever
    // required (see dashboard.js's reconcileFriendships() for how the acceptor's counterpart
    // creates their own mirror lazily on next load).
    match /friend_requests/{toUid}/incoming/{fromUid} {
      allow read: if request.auth != null && (request.auth.uid == toUid || request.auth.uid == fromUid);
      allow create: if request.auth != null && request.auth.uid == fromUid && fromUid != toUid
                    && request.resource.data.fromUid == fromUid
                    && request.resource.data.toUid == toUid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly([
                      'fromUid', 'toUid', 'status', 'fromDisplayName', 'fromUsername',
                      'fromPhotoURL', 'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && (
        (request.auth.uid == toUid && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined'])
        || (request.auth.uid == fromUid && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled')
        // Re-send after a decline/cancel reuses the same doc (Firestore's create rule only
        // fires when no doc exists yet), so the original sender may reset it back to pending.
        || (request.auth.uid == fromUid && resource.data.status in ['declined', 'cancelled']
          && request.resource.data.status == 'pending')
        // Re-send after a later unfriend: removeFriend() atomically marks the accepted request
        // cancelled while deleting both friendship mirrors. The original sender may then reset
        // it to pending for a new consent cycle.
        || (request.auth.uid == fromUid && resource.data.status == 'accepted'
          && request.resource.data.status == 'pending')
        // Either participant may end an accepted relationship. Revoking the request's accepted
        // state in the same batch as both mirror deletes prevents historical self-heal logic from
        // recreating Storage authorization after removal.
        || (request.auth.uid in [fromUid, toUid] && resource.data.status == 'accepted'
          && request.resource.data.status == 'cancelled')
      )
      && request.resource.data.fromUid == resource.data.fromUid
      && request.resource.data.toUid == resource.data.toUid
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /friendships/{uid}/friends/{friendUid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      // Only creatable as part of an accepted friend_requests doc between the same two people
      // (checked in either direction, since either side's client may be the one writing its own
      // mirror) — this is what stops anyone from freely adding themselves as a friend.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.friendUid == friendUid && (
        (exists(/databases/$(database)/documents/friend_requests/$(uid)/incoming/$(friendUid))
          && get(/databases/$(database)/documents/friend_requests/$(uid)/incoming/$(friendUid)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/friend_requests/$(friendUid)/incoming/$(uid))
          && get(/databases/$(database)/documents/friend_requests/$(friendUid)/incoming/$(uid)).data.status == 'accepted')
      );
      allow update: if false;
      // Either participant may revoke the relationship. This lets one atomic client batch remove
      // both mirrors, so Storage's single canonical owner->viewer lookup cannot remain stale.
      allow delete: if request.auth != null
                    && (request.auth.uid == uid || request.auth.uid == friendUid);
    }

    // Whitelist of approved friends, keyed by lowercase email (owner can approve someone
    // before they've ever signed in — a uid wouldn't exist yet at that point).
    match /friends/{email} {
      allow read: if isOwner() || (hasVerifiedEmail() && request.auth.token.email.lower() == email);
      allow write: if isOwner();
    }

    // Private account record. Public discovery uses public_profiles; Firestore cannot hide only
    // the email field while returning the rest of a users/{uid} document.
    function validPrivateUserIdentity(data, uid) {
      return data.uid == uid
             && data.email == request.auth.token.email
             && data.role == expectedRole();
    }
    function validPrivateUserFields(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'photoURL', 'role', 'displayName', 'createdAt', 'username',
        'bio', 'location', 'careerVisibility', 'lang'
      ])
      && (!('careerVisibility' in data)
          || data.careerVisibility in ['private', 'connections', 'public'])
      && (!('lang' in data) || data.lang in ['en', 'zh-CN']);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validPrivateUserIdentity(request.resource.data, uid)
                    && validPrivateUserFields(request.resource.data);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && validPrivateUserIdentity(request.resource.data, uid)
                    && request.resource.data.diff(resource.data).addedKeys().hasOnly([
                      'email', 'photoURL', 'role', 'displayName', 'createdAt', 'username',
                      'bio', 'location', 'careerVisibility', 'lang'
                    ])
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                      'email', 'photoURL', 'role', 'displayName', 'createdAt', 'username',
                      'bio', 'location', 'careerVisibility', 'lang'
                    ])
                    && (!('careerVisibility' in request.resource.data)
                        || request.resource.data.careerVisibility in ['private', 'connections', 'public'])
                    && (!('lang' in request.resource.data)
                        || request.resource.data.lang in ['en', 'zh-CN'])
                    && (
                      (('createdAt' in resource.data)
                        && request.resource.data.createdAt == resource.data.createdAt)
                      || (!('createdAt' in resource.data)
                          && (!('createdAt' in request.resource.data)
                              || request.resource.data.createdAt == request.time))
                    );
      allow delete: if false;
    }

    // Explicit public presentation mirror used by People/Profile and anonymous Resume routing.
    // It never contains email, authentication metadata, credentials, or admin flags.
    function validPublicProfileValues(data, uid) {
      return data.uid == uid
             && (!('displayName' in data) || data.displayName is string)
             && (!('username' in data) || data.username is string)
             && (!('photoURL' in data) || data.photoURL is string)
             && (!('bio' in data) || data.bio is string)
             && (!('location' in data) || data.location is string)
              && (!('careerVisibility' in data)
                  || data.careerVisibility in ['private', 'connections', 'public'])
              && (!('careerPolicyVersion' in data)
                  || (data.careerPolicyVersion is int && data.careerPolicyVersion >= 1))
              // Both capability records are exclusively Admin-managed. The active record contains
              // only a server-generated secret hash; the consumed record makes successful
              // completion explicitly one-time. Neither may originate in a client profile write.
              && !('careerPolicyTransition' in data)
              && !('careerPolicyLastConsumed' in data)
             // Kept only for existing People/Resume routing. This is display metadata, never an
             // authorization source, and every attempted change is derived by expectedRole().
             && (!('role' in data) || data.role == expectedRole());
    }

    match /public_profiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly([
                      'uid', 'displayName', 'username', 'photoURL', 'bio', 'location',
                      'careerVisibility', 'careerPolicyVersion',
                      'createdAt', 'role'
                    ])
                    && validPublicProfileValues(request.resource.data, uid)
                    && (expectedRole() != 'owner'
                        || (!('careerVisibility' in request.resource.data)
                            && !('careerPolicyVersion' in request.resource.data)))
                    && (!('createdAt' in request.resource.data)
                        || request.resource.data.createdAt == request.time);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.diff(resource.data).addedKeys().hasOnly([
                      'displayName', 'username', 'photoURL', 'bio', 'location',
                      'careerVisibility', 'careerPolicyVersion',
                      'createdAt', 'role'
                    ])
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                      'displayName', 'username', 'photoURL', 'bio', 'location',
                      'careerVisibility', 'careerPolicyVersion',
                      'createdAt', 'role'
                    ])
                    && (!('displayName' in request.resource.data)
                        || request.resource.data.displayName is string)
                    && (!('username' in request.resource.data)
                        || request.resource.data.username is string)
                    && (!('photoURL' in request.resource.data)
                        || request.resource.data.photoURL is string)
                    && (!('bio' in request.resource.data)
                        || request.resource.data.bio is string)
                    && (!('location' in request.resource.data)
                        || request.resource.data.location is string)
                    // These fields form one server-managed authorization state machine. Clients
                    // cannot acquire, replace, clear, or finalize a transition, including through
                    // a merge that changes only the public profile.
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'careerPolicyTransition', 'careerPolicyLastConsumed'
                    ])
                    && (expectedRole() != 'owner'
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'careerVisibility', 'careerPolicyVersion'
                        ]))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                        || request.resource.data.role == expectedRole())
                    && (
                      (('createdAt' in resource.data)
                        && request.resource.data.createdAt == resource.data.createdAt)
                      || (!('createdAt' in resource.data)
                          && (!('createdAt' in request.resource.data)
                              || request.resource.data.createdAt == request.time))
                    );
      allow delete: if false;
    }

    // Reservation doc per @username, doc ID = the lowercase handle itself — "first writer
    // wins" comes for free from Firestore's create-vs-update distinction (the `allow create`
    // rule only ever fires when no doc with that ID exists yet; a rename deletes the old
    // reservation and creates a new one, it never updates one in place). Read is world-open
    // (v3.2.2, was auth-required) — the doc only ever holds {uid, createdAt}, nothing sensitive,
    // and an unauthenticated resume.html?u=username visitor needs to resolve it to a uid.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && username.matches('^[a-z0-9_.]{3,24}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /login_logs/{logId} {
      allow read: if isOwner();
      allow create: if request.auth != null
                    && request.auth.token.email is string
                    && request.resource.data.keys().hasOnly([
                      'uid', 'email', 'loginTime', 'device', 'page'
                    ])
                    && request.resource.data.keys().hasAll([
                      'uid', 'email', 'loginTime', 'device', 'page'
                    ])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.device is string
                    && request.resource.data.device.size() <= 512
                    && request.resource.data.page is string
                    && request.resource.data.page == 'login'
                    && request.resource.data.page.size() <= 32
                    && request.resource.data.loginTime == request.time;
      allow update, delete: if false;
    }

    // Each user reads/marks-read only their own notifications; almost every notification is
    // still self-written by whoever's client observed the triggering condition — see the one
    // cross-user exception (friend_request/friend_accepted) in the create rule below.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read is bool;
      // v3.2: a friend_request/friend_accepted notification is the one exception to "always
      // self-written" — the sender writes directly into the recipient's inbox, self-attested via
      // fromUid == caller (no cross-user data leak beyond what the friend-request flow already
      // exposes: display name/username/photo, never email).
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.uid
        || (request.resource.data.fromUid == request.auth.uid
            && request.resource.data.uid != request.auth.uid
            && request.resource.data.keys().hasOnly([
              'uid', 'type', 'fromUid', 'title', 'message', 'read', 'createdAt'
            ])
            && request.resource.data.read == false
            && request.resource.data.createdAt == request.time
            && (
              (request.resource.data.type == 'friend_request'
                && exists(/databases/$(database)/documents/friend_requests/$(request.resource.data.uid)/incoming/$(request.auth.uid))
                && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.uid)/incoming/$(request.auth.uid)).data.status == 'pending')
              || (request.resource.data.type == 'friend_accepted'
                && exists(/databases/$(database)/documents/friend_requests/$(request.auth.uid)/incoming/$(request.resource.data.uid))
                && get(/databases/$(database)/documents/friend_requests/$(request.auth.uid)/incoming/$(request.resource.data.uid)).data.status == 'accepted')
            ))
      );
      allow delete: if false;
    }
  }
}
